    <div class="flex flex-col h-full" id="campaign-live-root" phx-hook="ScrollToUtterance">
      <div id="mic-controls" phx-hook="MicSetup" phx-update="ignore"></div>
      <.recording_bar
        owner?={@owner?}
        can_record?={@can_record?}
        active_session={@active_session}
        mic_on?={@mic_on?}
        recording_here?={@recording_here?}
        mic_streamers={@mic_streamers}
        mic_levels={@mic_levels}
        current_discord_id={@current_user.discord_id}
        users={@users}
        clock_tick={@clock_tick}
        discord_participants={@discord_participants}
      />

      <%!-- #915 (Cut 1): Lesen|Bearbeiten-Toggle (nur für Kuratoren sichtbar —
           reine Leser bleiben im Default-Lesemodus) + per-Gerät-Persistenz-Hook.
           #907: Link zur eigenständigen Spieler-Nachlese-Seite. --%>
      <div
        id="view-mode-persist"
        phx-hook="ViewModePersist"
        data-campaign-id={@campaign_id}
        class="px-6 py-1 border-b border-bg-3/40 flex items-center justify-end gap-3"
      >
        <%= if @can_edit_mode? do %>
          <div class="inline-flex rounded overflow-hidden border border-bg-3 text-xs" role="group" aria-label="Ansichtsmodus">
            <button
              type="button"
              phx-click="view_mode_toggle"
              phx-value-mode="lesen"
              class={[
                "px-3 py-1 transition-colors",
                @view_mode == :lesen && "bg-accent text-bg-0 font-medium" || "bg-bg-1 text-ink-2 hover:text-ink-1"
              ]}
              aria-pressed={@view_mode == :lesen}
            >
              📖 Lesen
            </button>
            <button
              type="button"
              phx-click="view_mode_toggle"
              phx-value-mode="bearbeiten"
              class={[
                "px-3 py-1 transition-colors border-l border-bg-3",
                @view_mode == :bearbeiten && "bg-accent text-bg-0 font-medium" || "bg-bg-1 text-ink-2 hover:text-ink-1"
              ]}
              aria-pressed={@view_mode == :bearbeiten}
            >
              ✏️ Bearbeiten
            </button>
          </div>
        <% end %>
        <.link navigate={~p"/campaigns/#{@campaign_id}/nachlese"} class="text-xs text-accent hover:underline">
          📖 Nachlese
        </.link>
      </div>

      <%= if @invite_url do %>
        <div class="px-6 py-3 bg-accent/10 border-b border-accent/40 flex items-center gap-3">
          <span class="hero-link-mini w-4 h-4 text-accent"></span>
          <span class="text-sm text-ink-1">Einladungs-Link:</span>
          <input
            readonly
            value={@invite_url}
            onclick="this.select()"
            class="flex-1 bg-bg-0 border border-bg-3 rounded px-2 py-1 text-sm text-accent font-mono"
          />
          <.ls_icon_btn_compat kind={:cancel} size={:sm} phx-click="clear_invite_url" title="Einladungs-Link ausblenden" />
        </div>
      <% end %>

      <%!-- Issue #1122: das Laufband. Es ersetzt den früheren eigenen
           Replay-Banner (dessen „~2 min pro Session" real 4-9 min bei Romeo
           und 80-110 min bei Free Seattle waren) und trägt den Replay als
           zweite Zeile — eine Anzeige statt zweier, die auseinanderlaufen. --%>
      <.pipeline_band
        lauf={@pipeline_lauf}
        sessions={@sessions}
        replay={@campaign_replay_running? && @campaign_replay_state}
        admin?={@perm_user && @perm_user.role == :admin}
      />

      <%!-- Issue #399: server-seitiger Stille-Watchdog. Sichtbar für GM + alle
            Live-Viewer, auch wenn der Tab des stillen Users tot ist. --%>
      <%!-- Issue #936/#938: Client-Outbox-Puffer (Chunks warten durabel auf
            Zustellung). Als fixed Overlay (bottom-right) statt Fluss-Balken —
            erscheint nur bei echtem Rückstau (Debounce, siehe BACKLOG_SHOW_MS)
            und verschiebt die Spalten dabei NICHT (kein Layout-Reflow). --%>
      <%= if (mb = assigns[:mic_buffered]) && mb.pending > 0 do %>
        <div class="fixed bottom-4 right-4 z-50 panel px-4 py-3 shadow-2xl flex items-center gap-3 text-sm max-w-md">
          <span class="inline-block w-2 h-2 rounded-full bg-accent animate-pulse shrink-0"></span>
          <span class="text-ink-1">
            ⏳ Puffert {mb.pending} Audio-Chunk(s) — durabel gespeichert, warten auf Zustellung{if mb.dropped > 0, do: " · #{mb.dropped} verworfen"}
          </span>
        </div>
      <% end %>

      <%= if @silent_streamers != [] do %>
        <div class="px-6 py-2 bg-danger/10 border-b border-danger/40 flex items-center gap-3 text-sm">
          <span class="inline-block w-2 h-2 rounded-full bg-danger animate-pulse"></span>
          <span class="text-ink-0 font-medium">
            ⚠ Kein hörbares Audio von {@silent_streamers |> Enum.map(&display_for(&1, @users)) |> Enum.join(", ")}
          </span>
          <span class="ml-auto text-xs text-ink-2">
            seit über 5&nbsp;min — Mikro stumm/abgezogen oder Browser eingefroren? Gerät prüfen.
          </span>
        </div>
      <% end %>

      <%!-- Issue #270: Top-Bar als Akkordeon-Reiter. Exklusiv — nur ein Tab
           offen zur Zeit. Click auf bereits offenen Tab toggled ihn zu.
           Save/Cancel/Confirm im Tab-Body setzen :open_tab zurück auf nil.
           "Kampagne löschen" ist nicht mehr hier — wandert in die
           Dashboard-Card (DashboardLive). --%>

      <%!-- Excel-Style horizontale Tab-Bar. Tab-Headers in einer Reihe,
           aktiver Tab unterstrichen mit Accent-Border. Body unter den
           Headers. Klick auf aktiven Header → :open_tab = nil → Body
           verschwindet. --%>
      <% can_pipeline? = @can_regenerate_campaign?
         can_flavor? = @can_edit_meta?
         can_vocab? = @can_vocab?
         can_calendar? = @can_calendar?
         can_discord_config? = @can_discord_config?
         any_tab? = can_pipeline? or can_flavor? or can_vocab? or can_calendar? or can_discord_config? %>

      <%!-- #915 (Cut 1): Kurations-Tabs (Pipeline/Stil/Vocab/Kalender) nur im
           Bearbeiten-Modus — im Lesemodus ist der Header ruhig. --%>
      <%= if any_tab? and @view_mode == :bearbeiten do %>
        <div class="border-b border-bg-3/40 bg-bg-1/30">
          <div class="flex items-center gap-1 px-4 pt-2">
            <%= if can_pipeline? do %>
              <.tab_header
                tab_id="pipeline"
                label="Pipeline neu starten"
                icon="hero-arrow-path"
                active?={@open_tab == :pipeline}
              />
            <% end %>
            <%= if can_flavor? do %>
              <.tab_header
                tab_id="flavor"
                label="Stil setzen"
                icon="hero-paint-brush"
                active?={@open_tab == :flavor}
              />
            <% end %>
            <%= if can_vocab? do %>
              <.tab_header
                tab_id="vocab"
                label="Vokabular bearbeiten"
                icon="hero-book-open"
                active?={@open_tab == :vocab}
              />
            <% end %>
            <%= if can_calendar? do %>
              <.tab_header
                tab_id="kalender"
                label="Kalender"
                icon="hero-calendar-days"
                active?={@open_tab == :kalender}
              />
            <% end %>
            <%= if can_discord_config? do %>
              <.tab_header
                tab_id="discord"
                label="Discord-Bot (Vorbereitung)"
                icon="hero-microphone"
                active?={@open_tab == :discord}
              />
            <% end %>
          </div>

          <%= case @open_tab do %>
            <% :pipeline -> %>
              <div :if={can_pipeline?} class="px-6 py-4">
                <p class="text-sm text-fg-muted mb-3">
                  Alle Sessions dieser Kampagne werden erneut durch die LLM-Pipeline geschickt.
                  Läuft ~{length(@sessions)} × ~2 min = ~{length(@sessions) * 2} min.
                  Resumées / Epos / Chronik werden überschrieben.
                </p>
                <.btn
                  variant="primary"
                  icon="refresh"
                  phx-click="rerun_campaign"
                  disabled={@campaign_replay_running?}
                >
                  Jetzt neu starten
                </.btn>

                <%!-- Issue #842: der Voll-Re-Cluster ist der seltene, explizite
                     Gegenpart zum automatischen inkrementellen Thread-Cluster-
                     Pfad (läuft bei jeder Session mit) — deshalb hier als
                     eigene, klar gewarnte Zweitaktion statt eigenem Tab. --%>
                <div class="mt-6 pt-4 border-t border-bg-3/40">
                  <p class="text-sm text-fg-muted mb-1">
                    Handlungsstränge komplett neu clustern (normalerweise nicht
                    nötig — läuft automatisch inkrementell mit, nur bei neuen
                    Fakten).
                  </p>
                  <p class="text-xs text-warning mb-3">
                    ⚠ Kanonische Namen können sich dabei ändern — bestehende
                    Umbenennungen/Zuordnungen im Fäden-Panel können dadurch
                    verwaisen.
                  </p>
                  <.btn
                    variant="secondary"
                    icon="refresh"
                    phx-click="rerun_thread_recluster"
                    disabled={@campaign_replay_running?}
                  >
                    Fäden neu clustern
                  </.btn>
                </div>
              </div>

            <% :flavor -> %>
              <div :if={can_flavor?} class="px-6 py-4">
                <.flavor_editor
                  campaign={@campaign}
                  stil_stage={@stil_stage}
                  segments={@preview_segments}
                  preview_error={@preview_error}
                  flavor_drafts={@flavor_drafts}
                  vorgabe_drafts={@vorgabe_drafts}
                  is_member?={@can_edit_meta?}
                />
              </div>

            <% :vocab -> %>
              <div :if={can_vocab?} class="px-6 py-4">
                <%= if @vocab_editing do %>
                  <form phx-submit="vocab_edit_save">
                    <textarea
                      name="vocab_hint"
                      rows="3"
                      class="w-full bg-bg-0 border border-bg-3 rounded px-2 py-1 text-xs text-ink-0 focus:border-accent focus:ring-0"
                      placeholder="Eigennamen, Orte, NPCs — kommagetrennt. Hilft Whisper beim Erkennen."
                    ><%= @vocab_draft %></textarea>
                    <div class="flex justify-end gap-2 mt-2">
                      <.btn variant="ghost" phx-click="vocab_edit_cancel">Abbrechen</.btn>
                      <.btn variant="primary" icon="check" type="submit">Speichern</.btn>
                    </div>
                  </form>
                <% else %>
                  <div class="text-xs text-ink-1 whitespace-pre-wrap">
                    <%= if @campaign && @campaign["vocab_hint"] && @campaign["vocab_hint"] != "" do %>
                      <%= @campaign["vocab_hint"] %>
                    <% else %>
                      <span class="italic text-ink-2/50">Kein Vokabular-Hint gesetzt.</span>
                    <% end %>
                  </div>
                <% end %>
              </div>

            <% :kalender -> %>
              <div :if={can_calendar?} class="px-6 py-4">
                <p class="text-xs text-ink-2 mb-2">
                  In-Game-Kalender dieser Kampagne — Basis für den Zeitstrahl. Ein Monat pro
                  Zeile als „Name Tage" (z.B. <span class="font-mono">Mirtul 30</span>). Leer =
                  gregorianischer Standard. Ändere den Kalender möglichst VOR der ersten Session.
                </p>
                <form phx-submit="calendar_edit_save">
                  <input
                    type="text"
                    name="epoch_label"
                    value={@calendar["epoch_label"] || ""}
                    placeholder="Epochen-Kürzel (optional), z.B. n. Chr. oder TZ"
                    class="w-full mb-2 bg-bg-0 border border-bg-3 rounded px-2 py-1 text-xs text-ink-0 focus:border-accent focus:ring-0"
                  />
                  <textarea
                    name="months"
                    rows="6"
                    class="w-full bg-bg-0 border border-bg-3 rounded px-2 py-1 text-xs text-ink-0 font-mono focus:border-accent focus:ring-0"
                    placeholder={"Januar 31\nFebruar 28\n…"}
                  ><%= StageEdits.calendar_to_text(@calendar) %></textarea>
                  <div class="flex justify-between gap-2 mt-2">
                    <.btn variant="ghost" phx-click="calendar_reset" type="button">
                      Gregorianisch
                    </.btn>
                    <.btn variant="primary" icon="check" type="submit">Speichern</.btn>
                  </div>
                </form>
              </div>

            <% :discord -> %>
              <div :if={can_discord_config?} class="px-6 py-4">
                <p class="text-xs text-warning mb-2">
                  ⚠ Nur Konfiguration — der Discord-Bot existiert noch nicht. Diese
                  Einstellung hat aktuell noch keine Wirkung.
                </p>
                <p class="text-xs text-ink-2 mb-2">
                  Guild-ID und Voice-Channel-ID des Discord-Servers, in dem der Bot
                  später der Aufnahme beitreten soll.
                </p>
                <form phx-submit="discord_config_edit_save">
                  <input
                    type="text"
                    name="guild_id"
                    inputmode="numeric"
                    value={@discord_config["guild_id"] || ""}
                    placeholder="Guild-ID (z.B. 123456789012345678)"
                    class="w-full mb-2 bg-bg-0 border border-bg-3 rounded px-2 py-1 text-xs text-ink-0 font-mono focus:border-accent focus:ring-0"
                  />
                  <input
                    type="text"
                    name="voice_channel_id"
                    inputmode="numeric"
                    value={@discord_config["voice_channel_id"] || ""}
                    placeholder="Voice-Channel-ID"
                    class="w-full mb-2 bg-bg-0 border border-bg-3 rounded px-2 py-1 text-xs text-ink-0 font-mono focus:border-accent focus:ring-0"
                  />
                  <div class="flex justify-end gap-2 mt-2">
                    <.btn variant="primary" icon="check" type="submit">Speichern</.btn>
                  </div>
                </form>
              </div>

            <% _ -> %>
          <% end %>
        </div>
      <% end %>

      <span
        id="persist-cols"
        phx-hook="PersistCols"
        phx-update="ignore"
        data-campaign-id={@campaign_id}
      >
      </span>

      <%!-- #915 (Cut 1): Kurator-Queue der offenen Falsifikations-Flags. Nur im
           Bearbeiten-Modus + GM (Lösen/Verwerfen = :resolve_flag, GM-only in
           Cut 1). Der Kurator löst am Substrat, nicht am gerenderten Span. --%>
      <div
        :if={@view_mode == :bearbeiten and @can_edit_meta? and @flags != []}
        class="px-6 py-2 border-b border-warning/40 bg-warning/5"
      >
        <p class="text-[11px] uppercase tracking-widest text-warning/80 mb-1">
          ⚠ {length(@flags)} offene Unstimmigkeits-Meldung(en)
        </p>
        <ul class="space-y-1">
          <li :for={f <- @flags} class="flex items-start gap-2 text-sm text-ink-1">
            <span class="text-[10px] font-mono text-ink-2/60 mt-0.5 flex-shrink-0">
              {f["target_kind"]}
            </span>
            <span class="flex-1 min-w-0">
              <span :if={f["note"] not in [nil, ""]}>{f["note"]}</span>
              <span :if={f["note"] in [nil, ""]} class="text-ink-2/60 italic">(ohne Notiz)</span>
              <span class="block text-[10px] text-ink-2/50">
                gemeldet von {display_for(f["raised_by"], @users)}
              </span>
            </span>
            <button
              type="button"
              phx-click="flag_resolve"
              phx-value-target_kind={f["target_kind"]}
              phx-value-target_id={f["target_id"]}
              class="text-xs text-success hover:underline flex-shrink-0"
              title="Berechtigt — am Substrat erledigt"
            >
              erledigt
            </button>
            <button
              type="button"
              phx-click="flag_dismiss"
              phx-value-target_kind={f["target_kind"]}
              phx-value-target_id={f["target_id"]}
              class="text-xs text-ink-2/60 hover:text-ink-1 flex-shrink-0"
              title="Unbegründet — verwerfen"
            >
              verwerfen
            </button>
          </li>
        </ul>
      </div>

      <div id="column-sync-host" class="flex-1 flex gap-px bg-bg-3/60 overflow-hidden" phx-hook="ColumnSync" data-sync-index={@sync_index_json}>
        <.column
          name="chronik"
          title={output_label(@campaign, "chronik")}
          subtitle=""
          busy?={MapSet.member?(@busy_stages, "timeline")}
          collapsed?={MapSet.member?(@collapsed_cols, "chronik")}
          can_collapse?={can_collapse?(@collapsed_cols, "chronik")}
        >
          <%!-- Issue #746: Review-Queue — verifizierte, aber unplatzierbare Fakten
               (Flashback/Zukunft/unklar ohne Datum/Offset). GM-only, damit die
               #686-Lücke sichtbar wird statt still zu verschwinden.
               Issue #724 Slice F: pro Fakt Datum setzen oder dauerhaft
               ausblenden (SessionFactDateSet) — extraction_event_id reitet
               als hidden Feld mit, damit der Worker-Read-Merge einen
               Regenerate-in-der-Zwischenzeit erkennt und den Override nicht
               fälschlich auf einen unbeteiligten neuen Fakt anwendet. --%>
          <details
            :if={@view_mode == :bearbeiten and @can_edit_meta? and @review_facts != []}
            class="mb-3 rounded border border-warning/40 bg-warning/5 px-2 py-2"
          >
            <summary class="text-xs text-warning cursor-pointer select-none">
              ⚠ {length(@review_facts)} Fakt(en) ohne Zeitstrahl-Datum — Datum setzen oder ausblenden
            </summary>
            <ul class="mt-2 space-y-1.5">
              <li :for={f <- @review_facts} class="text-xs text-ink-1">
                <div class="flex items-start gap-1.5">
                  <span class="flex-shrink-0 text-ink-2/70" title="Erzählzeit">
                    <%= case f["narration_time"] do %>
                      <% "flashback" -> %>⏮
                      <% "future" -> %>⏭
                      <% _ -> %>❓
                    <% end %>
                  </span>
                  <span class="flex-1 min-w-0">
                    {f["claim"]}
                    <span :if={f["character_alias"] not in [nil, ""]} class="text-accent/60">
                      — {f["character_alias"]}
                    </span>
                    <span :if={f["date_parse_error"] == true} class="block text-rec-soft mt-0.5">
                      ⚠ Datum „{f["in_game_date"]}" nicht auflösbar — Format prüfen (z.B. „15. Januar 1888" oder „1888-04-15")
                    </span>
                  </span>
                  <%= if @fact_date_editing != {f["session_id"], f["id"]} do %>
                    <.ls_icon_btn_compat
                      kind={:edit}
                      size={:sm}
                      phx-click="fact_date_edit_start"
                      phx-value-session={f["session_id"]}
                      phx-value-fact={f["id"]}
                      title="Datum setzen"
                    />
                    <button
                      type="button"
                      phx-click="fact_dismiss"
                      phx-value-session={f["session_id"]}
                      phx-value-fact={f["id"]}
                      phx-value-extraction_event_id={f["extraction_event_id"]}
                      data-confirm="Diesen Fakt dauerhaft ohne Zeitstrahl-Datum ausblenden?"
                      class="flex-shrink-0 text-ink-2/60 hover:text-ink-1"
                      title="Ohne Datum ausblenden"
                    >
                      ✕
                    </button>
                  <% end %>
                </div>
                <form
                  :if={@fact_date_editing == {f["session_id"], f["id"]}}
                  phx-submit="fact_date_edit_save"
                  class="mt-1 flex gap-1 items-center"
                >
                  <input type="hidden" name="session" value={f["session_id"]} />
                  <input type="hidden" name="fact" value={f["id"]} />
                  <input
                    type="hidden"
                    name="extraction_event_id"
                    value={f["extraction_event_id"]}
                  />
                  <input
                    type="text"
                    name="in_game_date"
                    value={if f["date_parse_error"] == true, do: f["in_game_date"], else: ""}
                    placeholder="In-Game-Datum, z.B. „15. Januar 1888“ oder „1888-04-15“"
                    class="flex-1 bg-bg-0 border border-bg-3 rounded px-2 py-1 text-xs text-ink-0 focus:border-accent focus:ring-0"
                  />
                  <.ls_icon_btn_compat kind={:confirm} size={:sm} type="submit" title="Speichern" />
                  <.btn variant="ghost" phx-click="fact_date_edit_cancel">Abbrechen</.btn>
                </form>
              </li>
            </ul>
          </details>
          <%!-- Issue #839/#836 (Epic #829 Slice D3/D2): Offene-Fäden-Panel — die
               Handlungsstränge (campaign_threads/1, #833) über die Cluster-Map
               (#832). Für ALLE Member sichtbar UND kuratierbar (Recall/#687,
               :curate_threads ist Member-Recht, nicht GM-only): rename/merge/
               resolve/dismiss + Undo. `auflösung`-Fakt = Abschluss-VORSCHLAG.
               #885: Arcs (Fäden) und Contexte (Themen = zeitloses Weltwissen)
               getrennt — Contexte unten, ohne Auflösungs-Semantik.
               #901: dritte Klasse "rauschen" (Meta-/Tisch-Gerede) — fällt aus
               der Hauptliste in ein zugeklapptes Unter-Register. --%>
          <%!-- Server-verwaltetes Akkordeon (kein natives <details> — das würde
               bei jeder Kurations-Aktion via morphdom zuschnappen, #836). --%>
          <%!-- #901: Rauschen-Stränge (Meta-/Tisch-Gerede) fallen aus der
               Hauptliste — eigenes zugeklapptes Unter-Register mit Zähler
               darunter (Kuration braucht Erreichbarkeit: Rettungs-Buttons). --%>
          <% glatt_contexts = Enum.filter(@campaign_threads, &(&1["kind"] == "context")) %>
          <% glatt_rauschen = Enum.filter(@campaign_threads, &(&1["kind"] == "rauschen")) %>
          <% glatt_sichtbar = Enum.reject(@campaign_threads, &(&1["kind"] == "rauschen")) %>
          <%!-- #905: dedupliziertes Arc-Ziel-Angebot (zwei Threads können auf
               denselben Arc paaren) für Merge- und Fakt-Umhäng-Selects. --%>
          <% arc_options =
            @campaign_threads
            |> Enum.filter(& &1["arc_id"])
            |> Enum.uniq_by(& &1["arc_id"]) %>
          <% arc_verwaiste = @arc_review["verwaiste"] || [] %>
          <% arc_gemergte = @arc_review["gemergte"] || [] %>
          <div
            :if={@view_mode == :bearbeiten and @is_member? and @campaign_threads != []}
            class="mb-3 rounded border border-accent/40 bg-accent/5 px-2 py-2"
          >
            <button
              type="button"
              phx-click="toggle_threads_panel"
              class="w-full text-left text-xs text-accent cursor-pointer select-none"
            >
              {if @threads_panel_open, do: "▾", else: "▸"} 🧵 {length(glatt_sichtbar) - length(glatt_contexts)} Handlungsfäden — {Enum.count(glatt_sichtbar, &(&1["kind"] != "context" and &1["status"] == "offen"))} offen<span :if={glatt_contexts != []}> · 📚 {length(glatt_contexts)} Themen</span>
            </button>
            <ul :if={@threads_panel_open} class="mt-2 space-y-2">
              <li :for={t <- glatt_sichtbar} class={"text-xs text-ink-1 #{if t["dismissed?"], do: "opacity-50", else: ""}"}>
                <%!-- #885: Trenner vor dem ersten Context (Sortierung: Arcs zuerst). --%>
                <div
                  :if={glatt_contexts != [] and t["key_canonical"] == hd(glatt_contexts)["key_canonical"]}
                  class="mt-1 mb-1 pt-1 border-t border-accent/20 text-[10px] uppercase tracking-widest text-ink-2/70"
                >
                  📚 Themen — Weltwissen, schließt nie ab
                </div>
                <div class="flex items-start gap-1.5">
                  <span class="flex-shrink-0" title={if t["kind"] == "context", do: "Thema (Weltwissen)", else: "Status: #{t["status"]}"}>
                    <%= cond do %>
                      <% t["dismissed?"] -> %>🚫
                      <% t["kind"] == "context" -> %>📚
                      <% t["status"] == "aufgelöst" -> %>✅
                      <% t["status"] == "ruhend" -> %>💤
                      <% true -> %>🔵
                    <% end %>
                  </span>
                  <span class="flex-1 min-w-0">
                    <span class={"font-medium #{if t["dismissed?"], do: "line-through", else: ""}"}>
                      {t["canonical"]}
                    </span>
                    <span :if={t["curated?"]} class="ml-1 text-ink-2/50" title="kuratiert">✎</span>
                    <span
                      :if={t["kind"] != "context" and t["resolution_suggested?"] == true and t["status"] != "aufgelöst"}
                      class="ml-1 text-warning"
                      title="Ein Fakt deutet einen Abschluss an"
                    >
                      🏁 Abschluss?
                    </span>
                    <span :if={(t["entities"] || []) != []} class="block text-ink-2/70">
                      {Enum.join(t["entities"], ", ")}
                    </span>
                    <span class="block text-ink-2/50">
                      {t["fact_count"]} Fakt(en) · Sitzung {t["opened_in_session"]}<span :if={
                        t["last_touched_session"] != t["opened_in_session"]
                      }>–{t["last_touched_session"]}</span>
                      <span :if={t["kind"] != "context" and t["status"] == "ruhend"}>· ruhend</span>
                    </span>

                    <%!-- #903 (Epic #900 S2): die Leitfrage des Arc-Objekts —
                         kuratiert (✎) überstimmt den :generiert-Draft. --%>
                    <span :if={t["leitfrage"]} class="block text-ink-2/70">
                      ❓ {t["leitfrage"]}<span :if={t["leitfrage_kuratiert?"]} class="ml-1 text-ink-2/50" title="kuratiert">✎</span>
                      <button :if={t["arc_id"]} type="button" phx-click="thread_curate_edit_start" phx-value-canonical={t["arc_id"]} phx-value-mode="leitfrage" class="ml-1 text-[10px] text-ink-2/70 hover:text-ink-1">
                        ✎ bearbeiten
                      </button>
                    </span>

                    <%!-- #905/#953: aufklappbare Fakt-Liste (id+claim-Projektion)
                         mit Fakt→Arc-Umhängen. #953: N:M — Multi-Select, ein Fakt
                         kann MEHREREN Bögen zugeordnet werden. „N Zuordnungen"
                         (nicht „N Fakten"): fact_count zählt einen Fakt in
                         mehreren Bögen mit. --%>
                    <button :if={(t["fact_list"] || []) != []} type="button" phx-click="thread_toggle_facts" phx-value-canonical={t["key_canonical"]} class="block text-[10px] text-ink-2/70 hover:text-ink-1">
                      {if @thread_facts_open == t["key_canonical"], do: "▾", else: "▸"} {length(t["fact_list"] || [])} Zuordnungen
                    </button>
                    <ul :if={@thread_facts_open == t["key_canonical"]} class="mt-0.5 space-y-1">
                      <li :for={f <- t["fact_list"] || []} class="text-[10px] text-ink-2/80 flex flex-col gap-0.5">
                        <span class="min-w-0">
                          {f["claim"]}
                          <span class="text-ink-2/50">(S{f["session_number"]})</span>
                          <span :if={f["overridden?"]} title="manuell zugeordnet (Auto aus)" class="text-accent">✎</span>
                        </span>
                        <%!-- #953: phx-change sendet das VOLLE angehakte Set;
                             kein Haken = leeres Set = „keine Bögen" (NICHT
                             Rücknahme). Rücknahme = „🔄 Auto" (Extraktions-Label-
                             Kette gilt wieder) — drei getrennte Zustände (#766). --%>
                        <% verwaist = (f["override_arc_ids"] || []) -- Enum.map(arc_options, & &1["arc_id"]) %>
                        <form phx-change="thread_fact_arc_save" class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
                          <input type="hidden" name="fact_id" value={f["id"]} />
                          <label :for={other <- arc_options} class="inline-flex items-center gap-0.5 cursor-pointer">
                            <input
                              type="checkbox"
                              name="arc_ids[]"
                              value={other["arc_id"]}
                              checked={f["overridden?"] and other["arc_id"] in (f["override_arc_ids"] || [])}
                              class="align-middle"
                            />
                            <span>{other["canonical"]}</span>
                          </label>
                          <button
                            type="button"
                            phx-click="thread_fact_arc_auto"
                            phx-value-fact_id={f["id"]}
                            class={["ml-1 hover:underline", if(f["overridden?"], do: "text-ink-2/70", else: "text-accent font-medium")]}
                            title="Zurück auf automatische Extraktions-Zuordnung (Label-Kette)"
                          >
                            🔄 Auto{if !f["overridden?"], do: " ✓", else: ""}
                          </button>
                          <span
                            :if={verwaist != []}
                            class="text-warning"
                            title={"Zuordnung(en) auf einen weg-geclusterten/gemergten Bogen: #{Enum.join(verwaist, ", ")}"}
                          >
                            ⚠ {length(verwaist)} verwaist
                          </span>
                        </form>
                      </li>
                    </ul>

                    <%!-- Kurations-Buttons (Member-Recht). --%>
                    <div class="mt-1 flex flex-wrap gap-1.5 text-[10px]">
                      <%!-- #903: Stränge MIT Arc-Objekt schließen/öffnen über
                           Arc-Akte (EINE Schließ-Wahrheit, Read-both/Write-new). --%>
                      <%= if t["arc_id"] do %>
                        <%= if t["arc_status"] == "geschlossen" do %>
                          <button type="button" phx-click="thread_arc_reopen" phx-value-arc_id={t["arc_id"]} class="text-accent hover:underline" title={"Bogen wieder öffnen (aktuell: #{t["arc_grund"]})"}>
                            ↩ wieder öffnen
                          </button>
                        <% else %>
                          <button type="button" phx-click="thread_arc_close" phx-value-arc_id={t["arc_id"]} phx-value-grund="geloest" class="text-success hover:underline" title="Leitfrage beantwortet — Erfolg oder Misserfolg">
                            ✓ auflösen
                          </button>
                          <button type="button" phx-click="thread_arc_close" phx-value-arc_id={t["arc_id"]} phx-value-grund="versandet" class="text-ink-2/60 hover:text-ink-1" title="Bewusst aufgegeben — neue Evidenz öffnet den Bogen automatisch wieder">
                            🌫 versandet
                          </button>
                        <% end %>
                      <% end %>
                      <%= if t["lifecycle_action"] in ["resolve", "dismiss"] do %>
                        <button type="button" phx-click="thread_curate" phx-value-action="reactivate" phx-value-canonical={t["key_canonical"]} class="text-accent hover:underline">
                          ↩ reaktivieren
                        </button>
                      <% else %>
                        <%!-- #885: „auflösen" nur für Arcs — ein Thema schließt nie ab.
                             #903: Legacy-resolve nur noch für arc-LOSE Stränge. --%>
                        <button :if={t["kind"] != "context" and is_nil(t["arc_id"])} type="button" phx-click="thread_curate" phx-value-action="resolve" phx-value-canonical={t["key_canonical"]} class="text-success hover:underline">
                          ✓ auflösen
                        </button>
                        <button type="button" phx-click="thread_curate" phx-value-action="dismiss" phx-value-canonical={t["key_canonical"]} class="text-ink-2/60 hover:text-ink-1">
                          ✕ ausblenden
                        </button>
                      <% end %>

                      <%!-- #885/#901: Kind-Umstufung (Member-Kuration; Undo = LLM-Einstufung gilt). --%>
                      <%= if t["kind_action"] in ["mark_arc", "mark_context", "mark_rauschen"] do %>
                        <button type="button" phx-click="thread_curate" phx-value-action="clear_kind" phx-value-canonical={t["key_canonical"]} class="text-accent hover:underline">
                          ↩ Einstufung zurücksetzen
                        </button>
                      <% else %>
                        <button :if={t["kind"] != "context"} type="button" phx-click="thread_curate" phx-value-action="mark_context" phx-value-canonical={t["key_canonical"]} class="text-ink-2/70 hover:text-ink-1" title="Kein Handlungsbogen — zeitloses Weltwissen">
                          📚 als Thema
                        </button>
                        <button :if={t["kind"] == "context"} type="button" phx-click="thread_curate" phx-value-action="mark_arc" phx-value-canonical={t["key_canonical"]} class="text-ink-2/70 hover:text-ink-1" title="Doch ein Handlungsbogen">
                          🧵 als Faden
                        </button>
                        <%!-- #901: Meta-/Tisch-Strang aus den inhaltlichen Sichten nehmen. --%>
                        <button type="button" phx-click="thread_curate" phx-value-action="mark_rauschen" phx-value-canonical={t["key_canonical"]} class="text-ink-2/70 hover:text-ink-1" title="Kein Inhalt — Meta-/Tisch-Gerede, ins Rauschen-Register ausblenden">
                          🔇 als Rauschen
                        </button>
                      <% end %>

                      <%= if t["identity_action"] in ["rename", "merge"] do %>
                        <button type="button" phx-click="thread_curate" phx-value-action="clear_identity" phx-value-canonical={t["key_canonical"]} class="text-accent hover:underline">
                          ↩ Label zurücksetzen
                        </button>
                      <% else %>
                        <button type="button" phx-click="thread_curate_edit_start" phx-value-canonical={t["key_canonical"]} phx-value-mode="rename" class="text-ink-2/70 hover:text-ink-1">
                          ✎ umbenennen
                        </button>
                        <button
                          :if={Enum.count(@campaign_threads, &(not &1["dismissed?"])) > 1}
                          type="button"
                          phx-click="thread_curate_edit_start"
                          phx-value-canonical={t["key_canonical"]}
                          phx-value-mode="merge"
                          class="text-ink-2/70 hover:text-ink-1"
                        >
                          ⤵ zusammenführen
                        </button>
                      <% end %>
                    </div>

                    <%!-- Inline-Rename-Form. --%>
                    <form
                      :if={@thread_curate_editing == {t["key_canonical"], "rename"}}
                      phx-submit="thread_rename_save"
                      class="mt-1 flex gap-1 items-center"
                    >
                      <input type="hidden" name="canonical" value={t["key_canonical"]} />
                      <input
                        type="text"
                        name="new_name"
                        value={t["canonical"]}
                        maxlength="120"
                        placeholder="Neues Label"
                        class="flex-1 bg-bg-0 border border-bg-3 rounded px-2 py-1 text-xs text-ink-0 focus:border-accent focus:ring-0"
                      />
                      <button type="submit" class="text-success text-[10px] hover:underline">Speichern</button>
                      <button type="button" phx-click="thread_curate_edit_cancel" class="text-ink-2/60 text-[10px]">Abbrechen</button>
                    </form>

                    <%!-- Inline-Merge-Form (Ziel-Strang wählen). --%>
                    <form
                      :if={@thread_curate_editing == {t["key_canonical"], "merge"}}
                      phx-submit="thread_merge_save"
                      class="mt-1 flex gap-1 items-center"
                    >
                      <input type="hidden" name="canonical" value={t["key_canonical"]} />
                      <select
                        name="merge_into"
                        class="flex-1 bg-bg-0 border border-bg-3 rounded px-2 py-1 text-xs text-ink-0 focus:border-accent focus:ring-0"
                      >
                        <option value="">— Ziel-Strang —</option>
                        <%= for other <- @campaign_threads, other["key_canonical"] != t["key_canonical"] and not other["dismissed?"] do %>
                          <option value={other["key_canonical"]}>{other["canonical"]}</option>
                        <% end %>
                      </select>
                      <button type="submit" class="text-success text-[10px] hover:underline">Zusammenführen</button>
                      <button type="button" phx-click="thread_curate_edit_cancel" class="text-ink-2/60 text-[10px]">Abbrechen</button>
                    </form>

                    <%!-- #903: Inline-Leitfragen-Form (leer speichern = Undo → Draft gilt). --%>
                    <form
                      :if={t["arc_id"] && @thread_curate_editing == {t["arc_id"], "leitfrage"}}
                      phx-submit="thread_leitfrage_save"
                      class="mt-1 flex gap-1 items-center"
                    >
                      <input type="hidden" name="arc_id" value={t["arc_id"]} />
                      <input
                        type="text"
                        name="text"
                        value={if t["leitfrage_kuratiert?"], do: t["leitfrage"], else: ""}
                        maxlength="300"
                        placeholder="Leitfrage (leer = generierter Draft gilt)"
                        class="flex-1 bg-bg-0 border border-bg-3 rounded px-2 py-1 text-xs text-ink-0 focus:border-accent focus:ring-0"
                      />
                      <button type="submit" class="text-success text-[10px] hover:underline">Speichern</button>
                      <button type="button" phx-click="thread_curate_edit_cancel" class="text-ink-2/60 text-[10px]">Abbrechen</button>
                    </form>
                  </span>
                </div>
              </li>
            </ul>
            <%!-- #901: Rauschen-Unter-Register — zugeklappt mit Zähler; die
                 Rettungs-Buttons (als Faden/Thema, Undo) machen die
                 Klassifikation kuratierbar, ohne die Hauptliste zu verstopfen. --%>
            <div :if={@threads_panel_open and glatt_rauschen != []} class="mt-2 pt-1 border-t border-accent/20">
              <button
                type="button"
                phx-click="thread_toggle_rauschen"
                aria-expanded={to_string(@rauschen_panel_open)}
                class="w-full text-left text-[10px] uppercase tracking-widest text-ink-2/70 cursor-pointer select-none"
              >
                {if @rauschen_panel_open, do: "▾", else: "▸"} 🔇 {length(glatt_rauschen)} Rauschen — Meta-/Tisch-Gerede, ausgeblendet
              </button>
              <ul :if={@rauschen_panel_open} class="mt-1 space-y-1">
                <li :for={t <- glatt_rauschen} class="text-xs text-ink-2/70">
                  <span title="Rauschen (Meta/Tisch)">🔇</span>
                  <span class="font-medium">{t["canonical"]}</span>
                  <span :if={t["curated?"]} class="ml-1 text-ink-2/50" title="kuratiert">✎</span>
                  <span class="text-ink-2/50">· {t["fact_count"]} Fakt(en)</span>
                  <div class="mt-0.5 flex flex-wrap gap-1.5 text-[10px]">
                    <%= if t["kind_action"] == "mark_rauschen" do %>
                      <button type="button" phx-click="thread_curate" phx-value-action="clear_kind" phx-value-canonical={t["key_canonical"]} class="text-accent hover:underline">
                        ↩ Einstufung zurücksetzen
                      </button>
                    <% else %>
                      <button type="button" phx-click="thread_curate" phx-value-action="mark_arc" phx-value-canonical={t["key_canonical"]} class="text-ink-2/70 hover:text-ink-1" title="Doch ein Handlungsbogen">
                        🧵 als Faden
                      </button>
                      <button type="button" phx-click="thread_curate" phx-value-action="mark_context" phx-value-canonical={t["key_canonical"]} class="text-ink-2/70 hover:text-ink-1" title="Doch zeitloses Weltwissen">
                        📚 als Thema
                      </button>
                    <% end %>
                  </div>
                </li>
              </ul>
            </div>

            <%!-- #905: ⚠ Arc-Review — verwaiste Bögen (Close-Status sichtbar
                 statt unsichtbar ruhend; Merge-Select mit Seed-Überlapp-
                 Vorauswahl = Duplikat-Hinweis) + Gemergte mit Undo. --%>
            <div :if={@threads_panel_open and (arc_verwaiste != [] or arc_gemergte != [])} class="mt-2 pt-1 border-t border-accent/20">
              <button
                type="button"
                phx-click="thread_toggle_arc_review"
                aria-expanded={to_string(@arc_review_open)}
                class="w-full text-left text-[10px] uppercase tracking-widest text-warning/80 cursor-pointer select-none"
              >
                {if @arc_review_open, do: "▾", else: "▸"} ⚠ Arc-Review — {length(arc_verwaiste)} verwaist<span :if={arc_gemergte != []}> · {length(arc_gemergte)} zusammengeführt</span>
              </button>
              <div :if={@arc_review_open} class="mt-1 space-y-2">
                <div :for={a <- arc_verwaiste} class="text-xs text-ink-2/80">
                  <span title={"Status: #{a["arc_status"]}#{if a["arc_grund"], do: " (#{a["arc_grund"]})", else: ""}"}>
                    {if a["arc_status"] == "geschlossen", do: "✅", else: "🔵"}
                  </span>
                  <span class="font-medium">{a["leitfrage"]}</span>
                  <span class="block text-ink-2/50">Seeds: {Enum.join(a["seeds"] || [], ", ")}</span>
                  <form phx-submit="thread_arc_merge_save" class="mt-0.5 flex gap-1 items-center">
                    <input type="hidden" name="arc_id" value={a["arc_id"]} />
                    <select name="merge_into" class="flex-1 bg-bg-0 border border-bg-3 rounded px-1 py-0.5 text-[10px] text-ink-0">
                      <option value="">— Ziel-Bogen —</option>
                      <%= for other <- arc_options, other["arc_id"] != a["arc_id"] do %>
                        <option value={other["arc_id"]} selected={a["vorschlag_arc_id"] == other["arc_id"]}>
                          {other["canonical"]}
                        </option>
                      <% end %>
                    </select>
                    <button type="submit" class="text-success text-[10px] hover:underline">⤵ zusammenführen</button>
                  </form>
                </div>
                <div :for={a <- arc_gemergte} class="text-[10px] text-ink-2/60">
                  <% ziel = Enum.find(arc_options, &(&1["arc_id"] == a["merge_into"])) %>
                  ⤵ {a["leitfrage"]} → <span class="font-medium">{(ziel && ziel["canonical"]) || a["merge_into"]}</span><span :if={a["wirksam?"] == false} title="Ziel fehlt oder ist selbst zusammengeführt — Redirect (noch) wirkungslos"> ⚠</span>
                  <button type="button" phx-click="thread_arc_unmerge" phx-value-arc_id={a["arc_id"]} class="ml-1 text-accent hover:underline">
                    ↩ lösen
                  </button>
                </div>
              </div>
            </div>
          </div>
          <%= cond do %>
            <% @waiting? and @chronik == [] -> %>
              <.empty_col text="Warte auf Worker." />
            <% @chronik == [] -> %>
              <.empty_col text="Noch keine In-Game-Einträge. (Stufe-4-LLM füllt das — bis dahin via /dev/event)" />
            <% true -> %>
              <% gap_ids = unbestaetigte_luecke_block_ids(@smoothed) %>
              <ol class="space-y-3">
                <%= for entry <- @chronik do %>
                  <li class="pl-3 border-l border-accent/40 group" id={"chronik-#{entry["id"]}"} data-anchor-id={entry["id"]}>
                    <%= if @chronik_editing == entry["id"] do %>
                      <form phx-submit="chronik_edit_save" class="space-y-1">
                        <textarea
                          name="chronik[markdown_body]"
                          rows="10"
                          autofocus
                          placeholder="# Datum&#10;## Titel&#10;&#10;Body als Markdown…"
                          class="w-full bg-bg-0 border border-bg-3 rounded px-2 py-1 text-xs text-ink-0 font-mono focus:border-accent focus:ring-0"
                        ><%= @chronik_draft %></textarea>
                        <div class="flex items-center justify-between">
                          <p class="text-[10px] text-ink-2">
                            Erste <code class="text-accent"># Zeile</code> = Datum,
                            <code class="text-accent">## Zeile</code> = Titel, Rest = Body.
                          </p>
                          <div class="flex gap-1">
                            <.ls_icon_btn_compat kind={:cancel} size={:sm} phx-click="chronik_edit_cancel" title="Abbrechen" />
                            <.ls_icon_btn_compat kind={:confirm} size={:sm} type="submit" title="Speichern" />
                          </div>
                        </div>
                      </form>
                    <% else %>
                      <div class="flex items-start justify-between gap-2">
                        <div class="flex-1 min-w-0">
                          <% md = entry["markdown_body"] %>
                          <%= cond do %>
                            <% is_binary(md) and md != "" -> %>
                              <%!-- Issue #440: gleiche Karten-Struktur wie Backward-Compat-Pfad, --%>
                              <%!-- nur der Body als gerendertes Markdown statt strip_md+clamp. --%>
                              <% {date, label, body} = StageEdits.parse_chronik_card_parts(md, entry) %>
                              <%= if date do %>
                                <div class="text-xs text-accent font-mono">{date}</div>
                              <% end %>
                              <%= if label do %>
                                <div class="text-ink-0 text-sm font-medium">{label}</div>
                              <% end %>
                              <%= if body != "" do %>
                                <div class={"text-ink-2 text-xs mt-1 line-clamp-3 " <> prose_classes()}>
                                  {render_md_safe(body)}
                                </div>
                              <% end %>
                            <% true -> %>
                              <%!-- Backward-Compat: alter Eintrag mit getrennten Feldern.
                                   Issue #724: der :wahrheitsbild-Zeitstrahl rendert hier —
                                   `~` markiert grobe Präzision (jahr-/jahrzehntgenau). --%>
                              <div class="text-xs text-accent font-mono flex items-center gap-1">
                                <span>{entry["in_game_date"]}</span>
                                <span
                                  :if={precision_approximate?(entry)}
                                  class="text-ink-2/70"
                                  title={precision_title(entry)}
                                >~</span>
                              </div>
                              <div class="text-ink-0 text-sm font-medium">{entry["label"]}</div>
                              <%= if entry["summary"] do %>
                                <div class="text-ink-2 text-xs mt-1 line-clamp-3">{strip_md(entry["summary"])}</div>
                              <% end %>
                          <% end %>
                        </div>
                        <div class="flex items-center gap-1">
                          <%!-- #917 (Cut 3): Gap-Trust-Marker — beruht auf einer
                               unbestätigten ASR-Lücke (vertrauen-aber-markieren). --%>
                          <span
                            :if={derivation_touches_gap?(entry["source_refs"], gap_ids)}
                            class="text-warning text-[10px]"
                            title="Beruht auf einer unbestätigten ASR-Lücke — optimistisch übernommen, per ⚠ falsifizierbar (#917)"
                          >🕳</span>
                          <%= if length(entry["source_refs"] || []) > 0 do %>
                            <button
                              type="button"
                              phx-click="show_refs"
                              phx-value-kind="chronik"
                              phx-value-id={entry["id"]}
                              class="text-[10px] text-accent/70 hover:text-accent font-mono cursor-pointer"
                              title="Quell-Blöcke ansehen — ein Block bündelt mehrere Zeilen (#864/#1094)"
                            >
                              📎 {length(entry["source_refs"])}
                            </button>
                          <% end %>
                          <%= if @can_edit_meta? and @view_mode == :bearbeiten do %>
                            <.ls_icon_btn_compat
                              kind={:edit}
                              phx-click="chronik_edit_start"
                              phx-value-id={entry["id"]}
                              title="Eintrag bearbeiten"
                            />
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                  </li>
                <% end %>
              </ol>
          <% end %>
        </.column>

        <.epos_column
          title={output_label(@campaign, "epos")}
          owner?={@owner?}
          gap_ids={unbestaetigte_luecke_block_ids(@smoothed)}
          can_edit?={@can_edit_meta?}
          waiting?={@waiting?}
          epos={@epos}
          epos_chapters={@epos_chapters}
          epos_history={@epos_history}
          epos_mode={@epos_mode}
          epos_draft={@epos_draft}
          epos_diff_seq={@epos_diff_seq}
          chapter_edit_id={@chapter_edit_id}
          chapter_draft={@chapter_draft}
          busy?={MapSet.member?(@busy_stages, "render_epos")}
          collapsed?={MapSet.member?(@collapsed_cols, "epos")}
          can_collapse?={can_collapse?(@collapsed_cols, "epos")}
        />

        <.column
          name="summaries"
          title={output_label(@campaign, "summary")}
          subtitle="Was letztes Mal geschah"
          busy?={
            MapSet.member?(@busy_stages, "render")
          }
          collapsed?={MapSet.member?(@collapsed_cols, "summaries")}
          can_collapse?={can_collapse?(@collapsed_cols, "summaries")}
        >
          <%= cond do %>
            <% @waiting? and @summaries == [] -> %>
              <.empty_col text="Warte auf Worker." />
            <% @summaries == [] -> %>
              <.empty_col text="Noch keine Session-Resümees. (Stufe-2-LLM erzeugt sie nach jeder Session — bis dahin via /dev/event)" />
            <% true -> %>
              <% sessions_by_id = Map.new(@sessions, &{&1["id"], &1}) %>
              <% gap_ids = unbestaetigte_luecke_block_ids(@smoothed) %>
              <div class="space-y-4">
                <%= for s <- @summaries do %>
                  <article class="pb-3 border-b border-bg-3/60 last:border-0" data-anchor-id={s["session_id"]}>
                    <header class="grid grid-cols-3 items-baseline gap-2 mb-1">
                      <div class="flex items-baseline gap-2">
                        <.local_time iso={s["generated_at"]} class="text-ink-2 text-xs font-mono" />
                        <span class={["pill", source_pill(s["source"])]}>
                          {s["source"]}
                        </span>
                      </div>
                      <div
                        class="text-center text-[10px] uppercase tracking-widest text-ink-2 truncate"
                        title={session_label(sessions_by_id[s["session_id"]], s["session_id"])}
                      >
                        {session_label(sessions_by_id[s["session_id"]], s["session_id"])}
                      </div>
                      <div class="flex items-baseline justify-end gap-2">
                        <%!-- #917 (Cut 3): Gap-Trust-Marker auf dem Resümee. --%>
                        <span
                          :if={derivation_touches_gap?(s["source_refs"], gap_ids)}
                          class="text-warning text-[10px]"
                          title="Beruht auf einer unbestätigten ASR-Lücke — optimistisch übernommen, per ⚠ falsifizierbar (#917)"
                        >🕳</span>
                        <%= if length(s["source_refs"] || []) > 0 do %>
                          <button
                            type="button"
                            phx-click="show_refs"
                            phx-value-kind="summary"
                            phx-value-id={s["session_id"]}
                            class="text-[10px] text-accent/70 hover:text-accent font-mono cursor-pointer"
                            title="Quell-Blöcke ansehen — ein Block bündelt mehrere Zeilen (#864/#1094)"
                          >
                            📎 {length(s["source_refs"])}
                          </button>
                        <% end %>
                        <%!-- #915 (Cut 1): Falsifikations-Flag pro Session — der
                             einzige Spieler-Signal-Pfad. Melden = jeder Member;
                             ⚠-Marker wenn offen (Kurator löst am Substrat). --%>
                        <%= if MapSet.member?(@flagged_keys, "session:#{s["session_id"]}") do %>
                          <span class="text-[10px] text-warning" title="Als unstimmig gemeldet — ein Kurator prüft es">
                            ⚠ gemeldet
                          </span>
                        <% end %>
                        <button
                          :if={@is_member? and not MapSet.member?(@flagged_keys, "session:#{s["session_id"]}")}
                          type="button"
                          phx-click="flag_raise"
                          phx-value-target_kind="session"
                          phx-value-target_id={s["session_id"]}
                          class="text-[10px] text-ink-2/40 hover:text-warning"
                          title="Unstimmigkeit melden — ein Kurator prüft es (nichts wird automatisch geändert)"
                        >
                          ⚠ melden
                        </button>
                        <%= if @can_edit_meta? and @view_mode == :bearbeiten do %>
                          <.ls_icon_btn_compat
                            kind={:edit}
                            phx-click="summary_edit_start"
                            phx-value-session={s["session_id"]}
                            title="Resümee bearbeiten"
                          />
                        <% end %>
                        <%= if @can_regenerate_session? and @view_mode == :bearbeiten do %>
                          <.ls_icon_btn_compat
                            kind={:regenerate}
                            phx-click="rerun_pipeline"
                            phx-value-session={s["session_id"]}
                            disabled={@campaign_replay_running?}
                            data-confirm="Ganzen Lauf für diese Session wiederholen? Die Glättung wird mit den aktuellen Regeln neu gerechnet, danach Extraktion, Verify und Resümee/Chronik/Epos."
                            title="Ganzen Lauf für diese Session wiederholen: Glättung → Extraktion → Verify → Resümee/Chronik/Epos. Die Glättung rechnet mit den aktuellen Regeln neu — bestehende Lücken-Kurationen können dabei verwaisen."
                          />
                        <% end %>
                      </div>
                    </header>
                    <%= if @summary_editing == s["session_id"] do %>
                      <form phx-submit="summary_edit_save" class="space-y-2">
                        <textarea
                          name="content_md"
                          class="w-full h-32 bg-bg-0 border border-bg-3 rounded p-2 text-sm font-mono text-ink-0 focus:border-accent focus:ring-0"
                          phx-update="ignore"
                          id={"summary-edit-#{s["session_id"]}"}
                        ><%= @summary_draft %></textarea>
                        <div class="flex justify-end gap-2">
                          <.ls_icon_btn_compat kind={:cancel} size={:sm} phx-click="summary_edit_cancel" title="Abbrechen" />
                          <.ls_icon_btn_compat kind={:confirm} size={:sm} type="submit" title="Speichern" />
                        </div>
                      </form>
                    <% else %>
                      <div class={["text-ink-0 text-sm leading-relaxed", prose_classes()]}>{render_md_safe(s["content_md"])}</div>
                    <% end %>
                  </article>
                <% end %>
              </div>
          <% end %>
        </.column>

        <%!-- #916 (Cut 2): editierbare Fakten-Spalte — die direkte L1-Wahrheits-
             basis-Kuration. Session-gruppiert, Inline-Edit pro Feld, Löschen
             (ausblenden), Span-Melden. Nur in der Bearbeiten-Palette. --%>
        <.column
          :if={"fakten" in @active_cols}
          name="fakten"
          title="Fakten"
          subtitle=""
          busy?={Enum.any?(["extract", "verify"], &MapSet.member?(@busy_stages, &1))}
          collapsed?={MapSet.member?(@collapsed_cols, "fakten")}
          can_collapse?={can_collapse?(@collapsed_cols, "fakten")}
        >
          <% sessions_by_id = Map.new(@sessions, &{&1["id"], &1}) %>
          <div class="p-2 space-y-3">
            <p :if={@facts == []} class="text-xs text-ink-2/60">
              Noch keine Fakten — nach der Extraktion einer Session erscheinen sie hier.
            </p>
            <div :for={group <- Enum.chunk_by(@facts, & &1["session_id"])}>
              <% sid = List.first(group)["session_id"] %>
              <h4 class="text-[10px] uppercase tracking-widest text-ink-2/60 mb-1">
                {session_label(sessions_by_id[sid], sid)}
              </h4>
              <ul class="space-y-2">
                <%!-- Issue #1095: data-anchor-id macht die Zeile für den
                      Scroll-Sync (#10) sichtbar — der IntersectionObserver
                      beobachtet ausschliesslich [data-anchor-id] bzw.
                      [data-utterance-id]. Ohne das Attribut kann die Spalte
                      weder führen noch folgen. Der Wert muss zum Key in
                      `build_sync_index/6` passen ("fakten:<f.id>"). --%>
                <li
                  :for={f <- group}
                  data-anchor-id={f["id"]}
                  class={[
                    "rounded border px-2 py-1.5 text-sm",
                    f["curation_dismissed"] && "border-bg-3/40 bg-bg-1/20 opacity-50" ||
                      "border-bg-3/60 bg-bg-1/30"
                  ]}
                >
                  <% quell = Enum.join(f["quell_utterance_ids"] || [], ",") %>
                  <%!-- claim (Textarea-Edit) --%>
                  <%= if @facts_editing == {sid, f["id"], "claim"} do %>
                    <form phx-submit="fact_save" class="space-y-1">
                      <input type="hidden" name="session" value={sid} />
                      <input type="hidden" name="quell" value={quell} />
                      <input type="hidden" name="field" value="claim" />
                      <textarea
                        name="value"
                        rows="2"
                        class="w-full bg-bg-0 border border-accent rounded px-1.5 py-1 text-sm text-ink-0 focus:ring-0"
                      >{f["claim"]}</textarea>
                      <div class="flex gap-2">
                        <.btn variant="primary" type="submit">Speichern</.btn>
                        <button type="button" phx-click="fact_edit_cancel" class="text-xs text-ink-2/60">Abbrechen</button>
                      </div>
                    </form>
                  <% else %>
                    <div class="flex items-start gap-1">
                      <span class={["flex-1", f["curation_dismissed"] && "line-through"]}>
                        {f["claim"]}
                        <span :if={f["verified?"] == false} class="lt-unverified" title="nicht verifiziert">⚠</span>
                      </span>
                      <button
                        :if={@can_edit_meta? or @is_member?}
                        type="button"
                        phx-click="fact_edit_start"
                        phx-value-session={sid}
                        phx-value-fact={f["id"]}
                        phx-value-field="claim"
                        class="text-[10px] text-ink-2/50 hover:text-accent"
                        title="Claim bearbeiten"
                      >✎</button>
                    </div>
                  <% end %>

                  <%!-- character + thread (Kurz-Inline) --%>
                  <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-ink-2/70">
                    <span>
                      👤
                      <%= if @facts_editing == {sid, f["id"], "character"} do %>
                        <form phx-submit="fact_save" class="inline-flex gap-1">
                          <input type="hidden" name="session" value={sid} />
                          <input type="hidden" name="quell" value={quell} />
                          <input type="hidden" name="field" value="character" />
                          <input type="text" name="value" value={f["character_alias"]} class="bg-bg-0 border border-accent rounded px-1 text-[11px] w-24" />
                          <button type="submit" class="text-success">✓</button>
                          <button type="button" phx-click="fact_edit_cancel" class="text-ink-2/60">✕</button>
                        </form>
                      <% else %>
                        <button type="button" phx-click="fact_edit_start" phx-value-session={sid} phx-value-fact={f["id"]} phx-value-field="character" class="hover:text-accent">
                          {f["character_alias"] || "—"} ✎
                        </button>
                      <% end %>
                    </span>
                    <span>
                      🧵
                      <%!-- #953: N:M — ein Fakt kann MEHREREN Strängen zugeordnet
                           sein. `threads`-Liste (Alt-Skalar `thread` als 1-Element
                           lesbar); Edit = ein Label pro Zeile (kein Komma-Split). --%>
                      <% f_threads = f["threads"] || (if f["thread"] in [nil, ""], do: [], else: [f["thread"]]) %>
                      <%= if @facts_editing == {sid, f["id"], "thread"} do %>
                        <form phx-submit="fact_save" class="inline-flex flex-col gap-1 align-top">
                          <input type="hidden" name="session" value={sid} />
                          <input type="hidden" name="quell" value={quell} />
                          <input type="hidden" name="field" value="thread" />
                          <textarea name="value" rows="3" placeholder="ein Label pro Zeile" class="bg-bg-0 border border-accent rounded px-1 text-[11px] w-32">{Enum.join(f_threads, "\n")}</textarea>
                          <div class="flex gap-1">
                            <button type="submit" class="text-success">✓</button>
                            <button type="button" phx-click="fact_edit_cancel" class="text-ink-2/60">✕</button>
                          </div>
                        </form>
                      <% else %>
                        <button type="button" phx-click="fact_edit_start" phx-value-session={sid} phx-value-fact={f["id"]} phx-value-field="thread" class="hover:text-accent">
                          {if f_threads == [], do: "—", else: Enum.join(f_threads, " · ")} ✎
                        </button>
                      <% end %>
                    </span>
                  </div>

                  <span :if={f["override_mehrdeutig"]} class="block mt-0.5 text-[10px] text-warning" title="Mehrere Fakten teilen diese Utterance-Menge — claim/löschen nicht eindeutig zuordenbar">
                    ⚠ mehrdeutiger Anker
                  </span>

                  <%!-- Aktionen: verified?-Toggle, Löschen/Wiederherstellen, Span-Melden --%>
                  <div class="mt-1 flex flex-wrap gap-x-3 text-[10px]">
                    <button type="button" phx-click="fact_toggle" phx-value-session={sid} phx-value-quell={quell} phx-value-field="verified" phx-value-value={to_string(f["verified?"] == false)} class="text-ink-2/60 hover:text-ink-1">
                      {if f["verified?"] == false, do: "als verifiziert markieren", else: "verifiziert-Flag aufheben"}
                    </button>
                    <%= if f["curation_dismissed"] do %>
                      <button type="button" phx-click="fact_toggle" phx-value-session={sid} phx-value-quell={quell} phx-value-field="dismissed" phx-value-value="false" class="text-accent hover:underline">
                        wiederherstellen
                      </button>
                    <% else %>
                      <button type="button" phx-click="fact_toggle" phx-value-session={sid} phx-value-quell={quell} phx-value-field="dismissed" phx-value-value="true" data-confirm="Diesen Fakt aus der Wahrheitsbasis ausblenden?" class="text-ink-2/60 hover:text-danger">
                        löschen
                      </button>
                    <% end %>
                    <button
                      :if={@is_member? and quell != "" and not MapSet.member?(@flagged_keys, "span:#{quell}")}
                      type="button"
                      phx-click="flag_raise"
                      phx-value-target_kind="span"
                      phx-value-target_id={quell}
                      class="text-ink-2/40 hover:text-warning"
                      title="Unstimmigkeit an diesem Fakt melden (Span)"
                    >⚠ melden</button>
                    <span :if={MapSet.member?(@flagged_keys, "span:#{quell}")} class="text-warning" title="gemeldet">⚠ gemeldet</span>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </.column>

        <%!-- Issue #871: geglättete Block-Ebene (Stage 1.1) als eigene Spalte
             direkt links vom Roh-Protokoll — die künftige Lese-Schicht; das
             Protokoll rechts bleibt Audit-Grundlage. Zeigt effektive Texte
             (Vorschlag/Kuration eingerechnet) mit Badges.

             #1122: Geglättet und Fakten haben die Plätze getauscht. Die
             Spalten stehen jetzt in Pipeline-Reihenfolge (von rechts nach
             links: Protokoll → Geglättet → Fakten → Resümee → Epos/Chronik),
             damit das Laufband dieselbe Ordnung tragen kann wie das Layout.
             Vorher wäre der Fortschrittspunkt zwischen den beiden einmal
             rückwärts gesprungen. --%>
        <.column
          name="glatt"
          title="Geglättet"
          subtitle="Transkript, Stage 1.1"
          busy?={MapSet.member?(@busy_stages, "smooth")}
          collapsed?={MapSet.member?(@collapsed_cols, "glatt")}
          can_collapse?={can_collapse?(@collapsed_cols, "glatt")}
          scroll_hook="UtteranceWindow"
          scroll_id="glatt-scroll"
        >
          <%= cond do %>
            <% @waiting? and @smoothed == [] -> %>
              <.empty_col text="Warte auf Worker." />
            <% @smoothed == [] -> %>
              <.empty_col text="Noch keine Glättung — läuft mit der Pipeline (🔄 neu generieren)." />
            <% true -> %>
              <% sessions_by_id = Map.new(@sessions, &{&1["id"], &1}) %>
              <div class="space-y-4">
                <%= for sm <- @smoothed do %>
                  <% view = glatt_view_for(@glatt_view, sm) %>
                  <%!-- #883: gleitendes #709-Fenster über die GEFILTERTE
                       Ansicht-Liste; Sentinels laden ältere/neuere nach. --%>
                  <% view_blocks = glatt_blocks(sm, view) %>
                  <% {blocks, hidden_before, hidden_after} = window_slice(view_blocks, sm["session_id"], @glatt_windows) %>
                  <article class="pb-3 border-b border-bg-3/60 last:border-0">
                    <header class="flex items-baseline justify-between gap-2 mb-1">
                      <span class="flex items-baseline gap-2 min-w-0">
                        <span
                          class="text-[10px] uppercase tracking-widest text-ink-2 truncate"
                          title={"Regelstand #{sm["rules_version"]} · merge_gap #{sm["merge_gap_seconds"]} s"}
                        >
                          {session_label(sessions_by_id[sm["session_id"]], sm["session_id"])}
                        </span>
                        <%!-- #871: Ansicht-Umschalter — kuratieren leert sich
                             selbst; Default fällt dann auf einfach. --%>
                        <span class="flex gap-1.5 text-[10px] whitespace-nowrap">
                          <button
                            type="button"
                            phx-click="luecke_view"
                            phx-value-session_id={sm["session_id"]}
                            phx-value-view="einfach"
                            class={glatt_view_btn_class(view, "einfach")}
                          >
                            einfach
                          </button>
                          <button
                            type="button"
                            phx-click="luecke_view"
                            phx-value-session_id={sm["session_id"]}
                            phx-value-view="kuratieren"
                            class={glatt_view_btn_class(view, "kuratieren")}
                          >
                            kuratieren<span :if={glatt_curatable_count(sm) > 0}> ({glatt_curatable_count(sm)})</span>
                          </button>
                          <button
                            type="button"
                            phx-click="luecke_view"
                            phx-value-session_id={sm["session_id"]}
                            phx-value-view="alles"
                            class={glatt_view_btn_class(view, "alles")}
                          >
                            alles
                          </button>
                        </span>
                      </span>
                      <span class="text-[10px] text-ink-2/60 whitespace-nowrap">
                        {length(sm["blocks"])} Blöcke<span :if={sm["ooc_verworfen_count"] > 0}> · {sm["ooc_verworfen_count"]} OOC verworfen</span><span :if={sm["praesenz_ping_verworfen_count"] > 0}> · {sm["praesenz_ping_verworfen_count"]} Präsenz-Pings verworfen</span>
                      </span>
                    </header>
                    <div :if={(sm["verwaist"] || []) != [] and view != "einfach"} class="mb-1 text-[10px] text-warning">
                      ⚠ Eine Regeländerung berührt {length(sm["verwaist"])} Kuration(en) dieser Sitzung (Review nötig) — bitte neu bestätigen.
                    </div>
                    <p :if={view == "kuratieren" and view_blocks == []} class="text-xs text-success">
                      ✓ Nichts zu kuratieren.
                    </p>
                    <div class="space-y-2">
                      <%!-- #883: Top-Sentinel — Scroll an den oberen Rand lädt
                           ältere Blöcke nach; Button = no-JS-Fallback. --%>
                      <div
                        :if={hidden_before > 0}
                        id={"glatt-top-#{sm["session_id"]}"}
                        class="text-center"
                        phx-viewport-top="luecke_load_older"
                        phx-value-session_id={sm["session_id"]}
                        phx-throttle="200"
                      >
                        <button
                          type="button"
                          phx-click="luecke_load_older"
                          phx-value-session_id={sm["session_id"]}
                          class="text-[11px] text-accent/80 hover:text-accent underline decoration-dotted underline-offset-2 py-1"
                          title="Ältere Blöcke dieser Session nachladen"
                        >
                          ↑ {hidden_before} ältere anzeigen
                        </button>
                      </div>
                      <%= for b <- blocks do %>
                        <%= if view == "einfach" do %>
                          <%!-- Endergebnis: effektiver Text, einfarbig, ohne
                               Diffs/Badges/Aktionen. Block-Anker für den Sync. --%>
                          <p class="text-sm leading-relaxed text-ink-0" data-anchor-id={b["block_id"]}>
                            <span class="text-xs font-mono">{display_for(b["speaker_discord_id"], @users)}:</span>
                            {b["text"]}
                          </p>
                        <% else %>
                          <div class="group" data-anchor-id={b["block_id"]}>
                            <p class={[
                              "text-sm leading-relaxed",
                              b["status"] == "unbrauchbar" && "line-through text-ink-2/50"
                            ]}>
                              <span class="text-accent/80 text-xs font-mono">{display_for(b["speaker_discord_id"], @users)}:</span>
                              <span :if={b["roh_text"] && b["roh_text"] != b["text_smoothed"]} class="text-ink-0">
                                <.luecken_diff old={b["roh_text"]} new={b["text_smoothed"]} />
                              </span>
                              <span :if={!(b["roh_text"] && b["roh_text"] != b["text_smoothed"])} class="text-ink-0">{b["text_smoothed"]}</span>
                              <span :if={b["hat_luecke"] and is_nil(b["status"])} class="text-warning" title="Erkannte ASR-Lücke — unkuratiert (optimistisch übernommen; Ableitungen tragen den 🕳-Marker, #917)">🕳</span>
                              <span :if={b["status"] in ["bestaetigt", "manuell_korrigiert", "original_bestaetigt"]} class="text-success" title={"kuratiert (#{b["status"]}) · von #{display_for(b["override"]["set_by"], @users)}"}>✓</span>
                              <span :if={b["status"] == "unbrauchbar"} title={"unbrauchbar — fließt nicht in die Extraktion · von #{display_for(b["override"]["set_by"], @users)}"}>🚫</span>
                            </p>

                            <%= if @is_member? and (b["hat_luecke"] or b["status"]) do %>
                              <p :if={b["vorschlag_text"] && b["status"] != "bestaetigt"} class="text-sm leading-relaxed pl-4">
                                💡 <.luecken_diff old={b["text_smoothed"]} new={b["vorschlag_text"]} />
                                <span class="text-ink-2/50 text-xs">({b["vorschlag_modell"]})</span>
                              </p>
                              <p :if={b["status"] == "manuell_korrigiert"} class="text-sm leading-relaxed pl-4 text-ink-2/70">
                                ✎ <.luecken_diff old={b["text_smoothed"]} new={b["override"]["bestaetigter_text"] || ""} />
                              </p>

                              <div class="pl-4 mt-0.5 flex flex-wrap gap-1.5 text-[10px]">
                                <button
                                  :if={(b["quell_utterance_ids"] || []) != []}
                                  type="button"
                                  phx-click="luecke_goto"
                                  phx-value-utt={List.first(b["quell_utterance_ids"])}
                                  class="text-accent hover:underline"
                                  title="Zur Stelle im Protokoll scrollen"
                                >
                                  ↪ Protokoll
                                </button>
                                <button
                                  :if={b["vorschlag_text"] && b["status"] != "bestaetigt"}
                                  type="button"
                                  phx-click="luecke_curate"
                                  phx-value-session_id={sm["session_id"]}
                                  phx-value-block_id={b["block_id"]}
                                  phx-value-status="bestaetigt"
                                  phx-value-text={b["vorschlag_text"]}
                                  class="text-success hover:underline"
                                >
                                  ✓ Vorschlag übernehmen
                                </button>
                                <button
                                  :if={b["status"] != "original_bestaetigt"}
                                  type="button"
                                  phx-click="luecke_curate"
                                  phx-value-session_id={sm["session_id"]}
                                  phx-value-block_id={b["block_id"]}
                                  phx-value-status="original_bestaetigt"
                                  phx-value-text={b["text_smoothed"]}
                                  class="text-success hover:underline"
                                >
                                  ✓ Original ist richtig
                                </button>
                                <button
                                  type="button"
                                  phx-click="luecke_edit_start"
                                  phx-value-session_id={sm["session_id"]}
                                  phx-value-block_id={b["block_id"]}
                                  class="text-ink-2/70 hover:text-ink-1"
                                >
                                  ✎ korrigieren
                                </button>
                                <button
                                  :if={b["status"] != "unbrauchbar"}
                                  type="button"
                                  phx-click="luecke_curate"
                                  phx-value-session_id={sm["session_id"]}
                                  phx-value-block_id={b["block_id"]}
                                  phx-value-status="unbrauchbar"
                                  phx-value-text=""
                                  class="text-ink-2/60 hover:text-ink-1"
                                >
                                  🚫 unbrauchbar
                                </button>
                              </div>

                              <form
                                :if={@luecke_editing == {sm["session_id"], b["block_id"]}}
                                phx-submit="luecke_edit_save"
                                class="pl-4 mt-1 flex gap-1 items-center"
                              >
                                <input type="hidden" name="session_id" value={sm["session_id"]} />
                                <input type="hidden" name="block_id" value={b["block_id"]} />
                                <input
                                  type="text"
                                  name="text"
                                  value={get_in(b, ["override", "bestaetigter_text"]) || b["vorschlag_text"] || b["text_smoothed"]}
                                  maxlength="2000"
                                  class="flex-1 bg-bg-0 border border-bg-3 rounded px-2 py-1 text-xs text-ink-0 focus:border-accent focus:ring-0"
                                />
                                <button type="submit" class="text-success text-[10px] hover:underline">Speichern</button>
                                <button type="button" phx-click="luecke_edit_cancel" class="text-ink-2/60 text-[10px]">Abbrechen</button>
                              </form>
                            <% end %>
                          </div>
                        <% end %>
                      <% end %>
                      <%!-- #883: Bottom-Sentinel — neuere Blöcke nachladen,
                           oberer Rand wird evincd. Button = no-JS-Fallback. --%>
                      <div
                        :if={hidden_after > 0}
                        id={"glatt-bottom-#{sm["session_id"]}"}
                        class="text-center"
                        phx-viewport-bottom="luecke_load_newer"
                        phx-value-session_id={sm["session_id"]}
                        phx-throttle="200"
                      >
                        <button
                          type="button"
                          phx-click="luecke_load_newer"
                          phx-value-session_id={sm["session_id"]}
                          class="text-[11px] text-accent/80 hover:text-accent underline decoration-dotted underline-offset-2 py-1"
                          title="Neuere Blöcke dieser Session nachladen"
                        >
                          ↓ {hidden_after} neuere anzeigen
                        </button>
                      </div>
                    </div>
                  </article>
                <% end %>
              </div>
          <% end %>
        </.column>

        <%!-- #915 (Cut 1): das rohe Protokoll ist Kurations-Substrat, kein
             Leser-Inhalt → nur in der Bearbeiten-Palette. --%>
        <.column
          :if={"protokoll" in @active_cols}
          name="protokoll"
          title="Protokoll"
          subtitle={protokoll_subtitle(@active_session)}
          busy?={MapSet.member?(@busy_stages, "stage1")}
          collapsed?={MapSet.member?(@collapsed_cols, "protokoll")}
          can_collapse?={can_collapse?(@collapsed_cols, "protokoll")}
          scroll_hook="UtteranceWindow"
          scroll_id="protokoll-scroll"
        >
          <%= cond do %>
            <% @waiting? and @utterances == [] -> %>
              <.empty_col text="Warte auf Worker." />
            <% @utterances == [] -> %>
              <.empty_col text={"Noch keine Utterances. Klick REC und feuere `mix lore.fake_session " <> @campaign_id <> "` in einer Shell."} />
            <% true -> %>
              <ol class="space-y-2">
                <%= for {session_label, group} <- group_by_session(@utterances, @sessions) do %>
                  <% sid = List.first(group)["session_id"] %>
                  <%!-- Issue #709: gleitendes, gedeckeltes Fenster — Render bounded egal wie weit gescrollt --%>
                  <% {view_group, hidden_before, hidden_after} = window_slice(group, sid, @utterance_windows, Map.get(@utterance_from, sid, 0)) %>
                  <% expanded? = MapSet.member?(@expanded_sessions, sid) %>
                  <% active? = !!(@active_session && @active_session.id == sid) %>
                  <% unassigned = unassigned_speaker_count(group, @speaker_assignments) %>
                  <%!-- Issue #724 Slice F: In-Game-Datum-Anker der Session (aus dem Snapshot). --%>
                  <% session_meta = Enum.find(@sessions, &(&1["id"] == sid)) || %{} %>
                  <% igd = session_meta["in_game_date_raw"] %>
                  <li class="pt-3 first:pt-0">
                    <div class="text-[10px] uppercase tracking-widest text-ink-2 mb-1 border-t border-bg-3/60 pt-2 first:border-0 first:pt-0 flex items-center justify-between gap-2">
                      <button
                        type="button"
                        phx-click="protokoll_session_toggle"
                        phx-value-session={sid}
                        class="flex-1 flex items-center gap-1.5 text-left hover:text-ink-0 transition-colors"
                        title={if expanded?, do: "Session zuklappen", else: "Session aufklappen"}
                      >
                        <span class={[
                          "inline-block transition-transform duration-150 text-ink-1",
                          expanded? && "rotate-90"
                        ]}>▸</span>
                        <span>{session_label}</span>
                        <span class="text-ink-2/70 normal-case tracking-normal">({length(view_group)})</span>
                        <span
                          :if={igd && igd != ""}
                          class="text-accent/60 normal-case tracking-normal font-mono"
                          title="In-Game-Datum dieser Session"
                        >📅 {igd}</span>
                        <%= if active? and not expanded? do %>
                          <span class="text-accent normal-case tracking-normal animate-pulse">● live</span>
                        <% end %>
                        <span
                          :if={unassigned > 0}
                          class="text-rec-soft normal-case tracking-normal"
                          title="Diarisierte Sprecher ohne Zuordnung — auf einen Sprecher im Protokoll klicken"
                        >
                          ⚠ {unassigned} Sprecher nicht zugewiesen
                        </span>
                      </button>
                      <%= if @can_edit_meta? and @session_date_editing != sid do %>
                        <.ls_icon_btn_compat
                          kind={:edit}
                          size={:sm}
                          phx-click="session_date_edit_start"
                          phx-value-session={sid}
                          title="In-Game-Datum dieser Session setzen"
                        />
                      <% end %>
                      <%= if expanded? and @can_edit_meta? and @utterance_adding != sid do %>
                        <.ls_icon_btn_compat
                          kind={:add}
                          phx-click="utterance_add_start"
                          phx-value-session={sid}
                          title="Manuellen Eintrag hinzufügen"
                        />
                      <% end %>
                      <%= if expanded? and @can_edit_meta? do %>
                        <.ls_icon_btn_compat
                          kind={:cascade_delete}
                          size={:sm}
                          phx-click="session_delete"
                          phx-value-session={sid}
                          data-confirm={"Session „" <> session_label <> "“ wirklich unwiderruflich löschen? Utterances, Marker, Resümee, Chronik-Einträge und Sprecher-Zuordnungen werden mitgelöscht."}
                          title="Session unwiderruflich löschen (Cascade)"
                        />
                      <% end %>
                    </div>
                    <%!-- Issue #724 Slice F: In-Game-Datum-Anker setzen (SessionInGameAnchorSet). --%>
                    <form
                      :if={@session_date_editing == sid}
                      phx-submit="session_date_edit_save"
                      class="mb-2 flex gap-1 items-center"
                    >
                      <input type="hidden" name="session" value={sid} />
                      <input
                        type="text"
                        name="in_game_date"
                        value={igd || ""}
                        placeholder="In-Game-Datum, z.B. „15. Januar 1888“ oder „1888-04-15“ (leer = löschen)"
                        class="flex-1 bg-bg-0 border border-bg-3 rounded px-2 py-1 text-xs text-ink-0 focus:border-accent focus:ring-0"
                      />
                      <.ls_icon_btn_compat kind={:confirm} size={:sm} type="submit" title="Speichern" />
                      <.btn variant="ghost" phx-click="session_date_edit_cancel">Abbrechen</.btn>
                    </form>
                    <ul :if={expanded?} class="space-y-2">
                      <%!-- #709: Top-Sentinel — Scroll an den oberen Rand lädt ältere
                           nach (phx-viewport-top) + evincd am unteren Rand. Button = no-JS-Fallback. --%>
                      <li
                        :if={hidden_before > 0}
                        id={"utt-top-#{sid}"}
                        class="text-center"
                        phx-viewport-top="utterance_load_older"
                        phx-value-session={sid}
                        phx-throttle="200"
                      >
                        <button
                          type="button"
                          phx-click="utterance_load_older"
                          phx-value-session={sid}
                          class="text-[11px] text-accent/80 hover:text-accent underline decoration-dotted underline-offset-2 py-1"
                          title="Ältere Utterances dieser Session nachladen"
                        >
                          ↑ {hidden_before} ältere anzeigen
                        </button>
                      </li>
                      <%= for u <- view_group do %>
                        <li
                          class={[
                            "text-xs relative group/utt py-0.5 border-l-2 pl-1.5",
                            if(asr_uncertain?(u), do: "border-warning/50", else: "border-transparent")
                          ]}
                          data-utterance-id={u["id"]}
                        >
                          <%= if @utterance_editing == u["id"] do %>
                            <div class="flex items-baseline gap-1">
                              <.local_time iso={u["timestamp"]} class="text-ink-2 font-mono mr-2" />
                              <span class="text-accent">{speaker_display(u["discord_id"], @speaker_assignments, @users, @character_names)}</span>
                              <form phx-submit="utterance_edit_save" class="flex-1 flex gap-1 items-start ml-1">
                                <textarea
                                  id={"utterance-edit-#{u["id"]}"}
                                  name="text"
                                  rows="2"
                                  phx-update="ignore"
                                  class="flex-1 bg-bg-0 border border-bg-3 rounded px-1.5 py-0.5 text-xs text-ink-0 focus:border-accent focus:ring-0"
                                ><%= @utterance_draft %></textarea>
                                <.ls_icon_btn_compat kind={:confirm} size={:sm} type="submit" title="Speichern" />
                                <.ls_icon_btn_compat kind={:cancel} size={:sm} phx-click="utterance_edit_cancel" title="Abbrechen" />
                              </form>
                            </div>
                          <% else %>
                            <.local_time iso={u["timestamp"]} class="text-ink-2 font-mono mr-2" />
                            <%= cond do %>
                              <% pseudo_speaker?(u["discord_id"]) and @can_assign_speaker? -> %>
                                <button
                                  type="button"
                                  phx-click="speaker_pick_start"
                                  phx-value-label={u["discord_id"]}
                                  phx-value-session={sid}
                                  class={[
                                    "text-accent underline decoration-dotted underline-offset-2 hover:text-accent/80 cursor-pointer",
                                    not Map.has_key?(@speaker_assignments, u["discord_id"]) && "italic"
                                  ]}
                                  title="Sprecher zuordnen"
                                >
                                  {speaker_display(u["discord_id"], @speaker_assignments, @users, @character_names)}
                                </button>
                              <% true -> %>
                                <span class={[
                                  "text-accent",
                                  pseudo_speaker?(u["discord_id"]) and
                                    not Map.has_key?(@speaker_assignments, u["discord_id"]) && "italic"
                                ]}>
                                  {speaker_display(u["discord_id"], @speaker_assignments, @users, @character_names)}
                                </span>
                            <% end %>
                            <%= if dot_class = status_dot_class(u["status"]) do %>
                              <span
                                class={["inline-block w-2 h-2 rounded-sm align-middle ml-1", dot_class]}
                                title={status_label(u["status"])}
                              />
                            <% end %>
                            <span
                              :if={asr_uncertain?(u)}
                              class="text-warning/70 text-[10px] ml-0.5 align-middle"
                              title={uncertainty_tooltip(u)}
                            >
                              ⚠︎
                            </span>
                            <span class={[
                              "ml-1",
                              u["status"] == "pending" && "text-ink-2 italic",
                              u["status"] == "live" && "text-ink-1 italic",
                              u["status"] == "edited" && "text-ink-0",
                              u["status"] == "manual" && "text-ink-0"
                            ]}>
                              {u["text"]}
                            </span>
                            <% citing_count = Map.get(@utterance_refs_index, u["id"], []) |> length() %>
                            <span class="absolute right-0 top-0 flex gap-0.5 items-center px-1 py-0.5 rounded bg-bg-1/95 backdrop-blur shadow-sm
                                          opacity-0 transition-opacity
                                          group-hover/utt:opacity-100
                                          group-focus-within/utt:opacity-100
                                          [@media(hover:none)]:opacity-100">
                              <%= if citing_count > 0 do %>
                                <button
                                  type="button"
                                  phx-click="show_utterance_refs"
                                  phx-value-id={u["id"]}
                                  class="text-[10px] text-accent/70 hover:text-accent font-mono cursor-pointer"
                                  title="Wer zitiert diese Utterance"
                                >
                                  ↑{citing_count}
                                </button>
                              <% end %>
                              <%= if Utterances.can_edit_utterance?(assigns, u) do %>
                                <.ls_icon_btn_compat
                                  kind={:edit}
                                  phx-click="utterance_edit_start"
                                  phx-value-id={u["id"]}
                                  title="Eintrag bearbeiten"
                                />
                                <.ls_icon_btn_compat
                                  kind={:delete}
                                  phx-click="utterance_delete"
                                  phx-value-id={u["id"]}
                                  data-confirm="Diesen Eintrag wirklich löschen?"
                                  title="Eintrag löschen"
                                />
                              <% end %>
                            </span>
                          <% end %>
                        </li>
                      <% end %>
                      <%!-- #709: Bottom-Sentinel — Scroll an den unteren Rand lädt neuere
                           nach (phx-viewport-bottom) + evincd am oberen Rand. Button = no-JS-Fallback. --%>
                      <li
                        :if={hidden_after > 0}
                        id={"utt-bot-#{sid}"}
                        class="text-center"
                        phx-viewport-bottom="utterance_load_newer"
                        phx-value-session={sid}
                        phx-throttle="200"
                      >
                        <button
                          type="button"
                          phx-click="utterance_load_newer"
                          phx-value-session={sid}
                          class="text-[11px] text-accent/80 hover:text-accent underline decoration-dotted underline-offset-2 py-1"
                          title="Neuere Utterances dieser Session nachladen"
                        >
                          ↓ {hidden_after} neuere anzeigen
                        </button>
                      </li>
                      <%= if @utterance_adding == sid do %>
                        <li class="text-xs">
                          <form
                            phx-submit="utterance_add_save"
                            class="flex flex-col gap-1 bg-bg-0 border border-accent/40 rounded p-2"
                          >
                            <div class="flex items-center gap-2">
                              <span class="text-[10px] uppercase tracking-widest text-ink-2">Sprecher</span>
                              <select
                                name="speaker"
                                class="bg-bg-1 border border-bg-3 rounded px-1.5 py-0.5 text-xs text-ink-0 focus:border-accent focus:ring-0"
                              >
                                <%= for m <- @members do %>
                                  <option
                                    value={m["discord_id"]}
                                    selected={m["discord_id"] == @utterance_add_speaker}
                                  >
                                    {display_for(m["discord_id"], @users, @character_names)}
                                  </option>
                                <% end %>
                              </select>
                            </div>
                            <textarea
                              name="text"
                              rows="2"
                              autofocus
                              placeholder="Was wurde gesagt / passierte?"
                              class="w-full bg-bg-1 border border-bg-3 rounded px-1.5 py-0.5 text-xs text-ink-0 focus:border-accent focus:ring-0"
                            ><%= @utterance_add_text %></textarea>
                            <div class="flex justify-end gap-1">
                              <.ls_icon_btn_compat kind={:cancel} size={:sm} phx-click="utterance_add_cancel" title="Abbrechen" />
                              <.ls_icon_btn_compat kind={:confirm} size={:sm} type="submit" title="Eintrag hinzufügen" />
                            </div>
                          </form>
                        </li>
                      <% end %>
                    </ul>
                  </li>
                <% end %>
              </ol>
          <% end %>

        </.column>
      </div>

      <%!-- Issue #445: Mitspieler-Bereich (Pillen-Leiste #270, Promote/Demote
           #140, Entfernen #55, Charakter-Name #2) als erstes LiveComponent des
           Hubs — Render-Isolation + Assign-Kapselung. create_invite bubblet
           bewusst zum Parent (invite_url + Banner leben hier). --%>
      <.live_component
        module={HubWeb.CampaignLive.MembersComponent}
        id="campaign-members"
        members={@members}
        users={@users}
        character_names={@character_names}
        current_user={@current_user}
        campaign={@campaign}
        campaign_id={@campaign_id}
        perm_user={@perm_user}
        owner?={@owner?}
        can_edit_meta?={@can_edit_meta?}
      />

      <%= if @owner? and Enum.any?(@invites, & &1["status"] == "active") do %>
        <div class="border-t border-bg-3/60 px-4 py-2 text-xs bg-bg-1">
          <div class="uppercase tracking-widest text-ink-2 mb-1">Offene Einladungen</div>
          <%= for inv <- @invites, inv["status"] == "active" do %>
            <div class="flex items-center gap-2 py-1">
              <span class="text-accent font-mono truncate">{inv["token"]}</span>
              <.ls_icon_btn_compat
                kind={:revoke}
                size={:sm}
                phx-click="revoke_invite"
                phx-value-token={inv["token"]}
                title="Einladung widerrufen"
                class="ml-auto"
              />
            </div>
          <% end %>
        </div>
      <% end %>

      <.mic_setup_modal
        :if={@show_mic_setup?}
        devices={@mic_setup_devices}
        consent_required={@mic_setup_consent_required?}
        consent_acked={@mic_setup_consent_acked?}
        consent_mode={@mic_setup_consent_mode}
        local_level={@mic_setup_local_level}
        phrase={@mic_setup_phrase}
        checking={@mic_setup_checking?}
        last_transcript={@mic_setup_last_transcript}
        phrase_ok={@mic_setup_phrase_ok?}
        error={@mic_setup_error}
      />

      <%!-- Issue #405: Silence-Modal lebt jetzt in HubWeb.MicLive (Capture-Owner). --%>

      <.refs_popover :if={@refs_popover} popover={@refs_popover} utterances={@utterances} lookup={@utterance_lookup} users={@users} character_names={@character_names} />

      <.speaker_picker
        :if={@speaker_pick}
        pick={@speaker_pick}
        members={@members}
        users={@users}
        character_names={@character_names}
        assignments={@speaker_assignments}
      />
    </div>
